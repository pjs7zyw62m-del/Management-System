# Copy to .env on the dedicated OS host. Never commit the real .env.
# A random 32+-character secret supplied by the OS secret manager.
BLACKCELL_AI_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_64_CHARACTER_INTERNAL_TOKEN

# Private, WireGuard/Tailscale or local GPU service endpoints only.
# Do NOT use public third-party inference endpoints for private media.
BLACKCELL_VISION_UPSTREAM=http://10.8.0.2:8000/v1
BLACKCELL_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
BLACKCELL_CHAT_UPSTREAM=http://10.8.0.2:8001/v1
BLACKCELL_CHAT_MODEL=REPLACE_WITH_SELF_HOSTED_CHAT_MODEL
BLACKCELL_GPU_API_KEY=REPLACE_WITH_PRIVATE_MODEL_SERVER_KEY
